# All configuration is optional — the app runs with zero environment variables
# as long as `ollama serve` is up and `llama3.1` is pulled.
#
# There is no API key anywhere in this project. Nothing leaves your machine.

# Where the Ollama daemon is listening.
# OLLAMA_HOST=http://127.0.0.1:11434

# Which local model scores acuity. Must be a tag you have pulled.
#   ollama pull llama3.1            -> llama3.1        (8B Instruct, the default)
#   ollama pull qwen2.5:14b         -> qwen2.5:14b     (stronger, ~9 GB)
#   ollama pull llama3.3:70b        -> llama3.3:70b    (much stronger, ~40 GB)
#   ollama pull cniongolo/biomistral -> cniongolo/biomistral (medical-tuned 7B)
# OLLAMA_MODEL=llama3.1

# Per-request ceiling in ms. Raise it if you are running a large model on CPU.
# OLLAMA_TIMEOUT_MS=90000

# How many patients to score at once. Keep it low — local models hate parallelism.
# SCORING_CONCURRENCY=2
